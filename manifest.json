  },
  "author": {
    "name": "Chrome Launcher",
    "url": "https://github.com/liliBestCoder"
  },
  "homepage": "https://github.com/liliBestCoder/ghost-chrome-launcher",
  "category": "productivity",
  "icon": "icon.png",
  "entry": "chrome-launcher.exe",
  "runtime": { "kind": "none" },
  "ui": { "embedded": true },
  "permissions": [
    "ghost.target.v1",
    "ghost.upstream.v1",
    "ghost.egress.v1"
  ]
}
